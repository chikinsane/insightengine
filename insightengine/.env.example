# ── Clerk Authentication ─────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs — leave these as-is unless you change your route structure
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Create a free database at https://neon.tech → copy the "pooled connection" string
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── AI (Anthropic) ───────────────────────────────────────────────────────────
# Get your API key from https://console.anthropic.com/settings/api-keys
# Make sure your account has credits at https://console.anthropic.com/settings/billing
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Netlify Blobs ─────────────────────────────────────────────────────────────
# No config needed — injected automatically by Netlify at runtime.
# For local dev, Netlify CLI (netlify dev) injects this for you.
